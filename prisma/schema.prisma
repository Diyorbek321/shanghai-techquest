generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Track {
  FRONTEND
  ROBOTICS
  OFFICE
  BACKEND
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

enum EventType {
  CLASS
  DEADLINE
  EXAM
  EVENT
}

enum BuildingType {
  RESIDENTIAL
  TECH
  INDUSTRIAL
  MONUMENT
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementCategory {
  PROGRAMMING
  SPEED
  SOCIAL
  SPECIAL
  SECRET
}

enum AchievementCondition {
  FIRST_SUBMISSION
  SUBMISSIONS_COUNT
  MIDNIGHT_SUBMISSIONS
  PROBLEM_SUBMISSIONS_PASSED
  DIRECT_MESSAGES_SENT
  XP_REACHED
  LEVEL_REACHED
  STREAK_REACHED
  ELO_REACHED
  COINS_BALANCE
  BATTLES_WON
  SHOP_ITEMS_OWNED
  FRIENDS_COUNT
  TEAM_JOINED
  QUESTS_COMPLETED
  HOMEWORK_COMPLETED
  GRADES_ABOVE_90
}

enum ItemType {
  FRAME
  THEME
  BOOST
  MATERIAL
  UPGRADE
  TITLE
  BLUEPRINT
}

enum TeamRole {
  LEADER
  MEMBER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
  MASTER
}

enum BattleStatus {
  AWAITING_OPPONENT
  JUDGING
  JUDGED
}

/// What a ClassGoal counts. Every option must be countable inside a date
/// window: QuizAttempt is deliberately absent because it is upserted in place,
/// so its timestamp is the last answer rather than one event per attempt.
enum ClassGoalMetric {
  PROBLEMS_SOLVED
  DAILY_EXERCISES
  HOMEWORK_DONE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum UiTheme {
  DARK
  NEON
  CYBER
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  role           Role     @default(STUDENT)
  track          Track?
  level          Int      @default(1)
  xp             Int      @default(0)
  coins          Int      @default(0)
  streak         Int      @default(0)
  /// Unused streak freezes bought from the shop. One is spent automatically
  /// when a missed day would otherwise reset `streak` back to 1.
  streakFreezes  Int      @default(0)
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  theme          UiTheme  @default(DARK)
  audioEnabled   Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  onlineVisible  Boolean  @default(true)
  profilePublic  Boolean  @default(true)
  lastSeenAt     DateTime?
  eloRating      Int      @default(1200)

  teamId   String?
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamRole TeamRole?

  taughtClasses  ClassGroup[]     @relation("ClassTeacher")
  enrollments    Enrollment[]
  submissions    Submission[]
  grades         Grade[]
  homework       Homework[]
  attendances    Attendance[]
  notifications  Notification[]
  userQuests     UserQuest[]
  moduleProgress ModuleProgress[]
  buildings      Building[]

  userAchievements     UserAchievement[]
  inventory            UserInventory[]
  problemSubmissions   ProblemSubmission[]
  battlesAsChallenger  BattleChallenge[] @relation("BattleChallenger")
  battlesAsOpponent    BattleChallenge[] @relation("BattleOpponent")
  chatMessages         ChatMessage[]
  friendshipsSent      Friendship[]      @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]      @relation("FriendshipAddressee")
  sentMessages         DirectMessage[]   @relation("DMSender")
  receivedMessages     DirectMessage[]   @relation("DMRecipient")
  dailyExerciseLogs    DailyExerciseLog[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  pairedSubmissions    Submission[]      @relation("SubmissionPartner")

  @@index([teamId])
}

model ClassGroup {
  id          String   @id @default(cuid())
  title       String
  track       Track
  teacherId   String
  teacher     User     @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  schedule    String?
  /// First lesson date. Lesson N's deadline is derived from this plus lessonDays.
  startDate   DateTime?
  /// Weekdays lessons are held on (0 = Sunday). Defaults to Mon/Wed/Fri.
  lessonDays  Int[]    @default([1, 3, 5])
  createdAt   DateTime @default(now())

  enrollments Enrollment[]
  assignments Assignment[]
  events      CalendarEvent[]
  attendances Attendance[]
  homework    Homework[]
  goals       ClassGoal[]

  @@index([teacherId])
}

model Enrollment {
  id       String   @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId  String
  class    ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@unique([userId, classId])
  @@index([classId])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  track       Track
  classId     String?
  class       ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  xpReward    Int      @default(0)
  moduleKey   String?
  createdAt   DateTime @default(now())

  submissions Submission[]
  grades      Grade[]

  @@index([classId])
  @@index([lessonId])
  // Class-scoped: each cohort gets its own copy of a lesson's homework with a
  // deadline derived from that cohort's start date. Self-paced module tasks keep
  // classId = null, which Postgres treats as distinct — seeding those goes
  // through an explicit moduleKey lookup instead of relying on this constraint.
  @@unique([track, classId, moduleKey])
}

/// One session of a taught curriculum, extracted from its slide deck by
/// scripts/extractLessons.ts. Track-agnostic so other tracks can adopt it later.
model Lesson {
  id             String   @id @default(cuid())
  key            String   @unique
  track          Track
  order          Int
  month          Int
  week           Int
  title          String
  section        String
  summary        String
  objectives     String[]
  homeworkMain   String
  homeworkReview String[]
  homeworkNote   String   @default("")
  makeEasy       String
  makeMedium     String
  makeHard       String
  quiz           String[]
  nextTopic      String?
  nextPrompt     String?
  /// File name inside lesson-assets/<track>/ — served by GET /api/lessons/:key/slides.
  slideFile      String?
  /// 'lesson' | 'project'
  kind           String   @default("lesson")
  xpReward       Int      @default(0)

  assignments   Assignment[]
  problems      Problem[]
  quizQuestions QuizQuestion[]
  projectRubric ProjectRubric?

  @@unique([track, order])
  @@index([track, month])
}

/// One multiple-choice retrieval-practice question attached to a lesson.
/// `choices` must hold exactly 4 options; that invariant is enforced in
/// application code (Prisma cannot express array length constraints).
model QuizQuestion {
  id           String @id @default(cuid())
  lessonId     String
  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order        Int
  prompt       String
  /// Exactly 4 options.
  choices      String[]
  /// Index into `choices` of the correct option (0..3).
  correctIndex Int
  /// Short Uzbek explanation shown to the student after answering.
  explanation  String

  attempts QuizAttempt[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

/// Spaced-repetition state: exactly one row per (user, question), updated in
/// place every time the student reviews that question.
model QuizAttempt {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Outcome of the most recent answer.
  correct    Boolean
  /// Consecutive correct answers; drives the next review interval.
  streak     Int          @default(0)
  timesSeen  Int          @default(0)
  timesCorrect Int        @default(0)
  answeredAt DateTime     @default(now())
  /// When this question should resurface for review.
  dueAt      DateTime

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

/// An issued certificate. Rows are immutable once written: a certificate that
/// can change after the fact is not evidence of anything.
model Certificate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track  Track
  /// 'month' for one block of the curriculum, 'course' for the whole track.
  kind   String
  /// Null for a course certificate; the Lesson.month it covers otherwise.
  month  Int?
  title  String
  /// Printed on the certificate so a third party can ask the school to confirm it.
  serial String @unique
  /// Snapshot at issue time — the curriculum can grow later, and a certificate
  /// must keep meaning what it meant on the day it was earned.
  lessonsCompleted Int
  lessonsTotal     Int
  issuedAt         DateTime @default(now())

  /// One certificate per scope; re-claiming is a no-op rather than a duplicate.
  @@unique([userId, track, kind, month])
  @@index([userId])
}

/// Grading criteria for a project lesson (Lesson.kind === 'project').
model ProjectRubric {
  id       String @id @default(cuid())
  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// [{ "label": string, "maxPoints": number, "hint": string }]
  criteria Json   @default("[]")
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?
  githubUrl    String?
  demoUrl      String?
  fileUrl      String?
  fileName     String?
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  /// [{ "label": string, "points": number, "note": string }] — per-criterion rubric marks.
  rubricScores Json     @default("[]")
  /// Student's short written defense of their own project.
  defense      String   @default("")
  /// The classmate this work was written with. Recorded on BOTH students' rows,
  /// so either one's own page tells the truth about who they worked with and a
  /// teacher never has to guess which name is the "real" author.
  partnerId    String?
  partner      User?    @relation("SubmissionPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, userId])
  @@index([userId])
}

model Grade {
  id           String   @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  subject      String
  score        Float
  maxScore     Float    @default(100)
  gradedAt     DateTime @default(now())

  @@index([userId])
  @@index([assignmentId])
}

model Homework {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track
  title     String
  course    String
  dueDate   DateTime
  completed Boolean  @default(false)
  /// Set when a teacher assigned this to one of their classes; null for the
  /// older track-wide broadcasts, which stay readable.
  classId   String?
  class     ClassGroup? @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// Groups the per-student rows created by one assignment action, so the
  /// teacher's completion view can roll them up without matching on title.
  batchId   String?

  @@index([userId])
  @@index([classId])
  @@index([batchId])
}

/// A collective target for a whole cohort — "this week the class solves 100
/// problems". Individual leaderboards only ever motivate the top of the class;
/// a shared bar pulls the students who are behind, because the group needs
/// their contribution too.
///
/// Progress is not stored: it is counted from the underlying events inside the
/// window (see server/classGoals/progress.ts), so it can never drift out of
/// sync with reality. Only the payout is recorded, via `achievedAt`.
model ClassGoal {
  id         String          @id @default(cuid())
  classId    String
  class      ClassGroup      @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  metric     ClassGoalMetric
  target     Int
  startsAt   DateTime
  endsAt     DateTime
  /// XP paid to every enrolled student, once, when the target is first reached.
  xpReward   Int             @default(0)
  /// Set when the reward has been paid, so it is never paid twice.
  achievedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([classId])
}

model Attendance {
  id      String   @id @default(cuid())
  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId String?
  class   ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  date    DateTime
  status  AttendanceStatus

  @@unique([userId, classId, date])
  @@index([classId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model CalendarEvent {
  id       String     @id @default(cuid())
  title    String
  track    Track?
  classId  String?
  class    ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  type     EventType
  startsAt DateTime
  endsAt   DateTime?

  @@index([classId])
}

model Quest {
  id         String   @id @default(cuid())
  track      Track?
  title      String
  xpReward   Int
  chapterId  String?

  userQuests UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, questId])
  @@index([questId])
}

model ModuleProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track
  moduleKey String
  progress  Int      @default(0)
  unlocked  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey])
}

model Building {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           BuildingType
  position       Json
  color          String
  secondaryColor String?
  name           String
  level          Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
}

model Achievement {
  id             String               @id @default(cuid())
  key            String               @unique
  name           String
  description    String
  rarity         Rarity
  category       AchievementCategory
  conditionType  AchievementCondition
  conditionValue Int

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlocked      Boolean   @default(false)
  progress      Int       @default(0)
  unlockedAt    DateTime?

  @@unique([userId, achievementId])
  @@index([achievementId])
}

model Item {
  id     String   @id @default(cuid())
  key    String   @unique
  name   String
  type   ItemType
  price  Int
  rarity Rarity

  inventories UserInventory[]
}

model UserInventory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acquiredAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([itemId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  motto     String?
  tag       String   @unique
  color     String
  createdAt DateTime @default(now())

  members User[]
}

model Problem {
  id             String     @id @default(cuid())
  key            String     @unique
  title          String
  difficulty     Difficulty
  points         Int
  tags           String[]
  description    String
  // Nullable: lesson-linked practice problems are Python-only, so the UI offers
  // just the languages that actually have starter code.
  starterCodeJs  String?
  starterCodePy  String?
  starterCodeCpp String?
  /// Reference solution, used ONLY to build the Parsons (line-ordering) variant.
  /// Null means this problem has no Parsons mode. Never sent to a student: the
  /// API ships shuffled lines, never the ordered source. A value here is only
  /// written by scripts/addParsonsSolutions.ts, which refuses to store a
  /// solution that does not pass the problem's own test cases — a Parsons
  /// exercise built from wrong code would drill the wrong structure.
  solutionPy     String?
  /// Set for bonus practice attached to a taught lesson; null for the general pool.
  lessonId       String?
  lesson         Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// [{ "stdin": string, "expectedStdout": string, "hidden": boolean, "label": string }]
  testCases      Json       @default("[]")

  submissions ProblemSubmission[]
  battles     BattleChallenge[]

  @@index([lessonId])
}

model ProblemSubmission {
  id            String   @id @default(cuid())
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String
  language      String
  passed        Boolean
  feedback      String
  pointsAwarded Int
  /// How many of `testsTotal` test cases the run passed; 0/0 for legacy rows.
  testsPassed   Int      @default(0)
  testsTotal    Int      @default(0)
  submittedAt   DateTime @default(now())

  @@index([userId])
  @@index([problemId])
}

model BattleChallenge {
  id              String       @id @default(cuid())
  challengerId    String
  challenger      User         @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String?
  opponent        User?        @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  isAI            Boolean      @default(false)
  problemId       String
  problem         Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        String       @default("javascript")
  status          BattleStatus @default(AWAITING_OPPONENT)
  challengerCode  String?
  opponentCode    String?
  challengerScore Int?
  opponentScore   Int?
  winnerId        String?
  feedback        String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([challengerId])
  @@index([opponentId])
  @@index([problemId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("DMRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model DailyExercise {
  id         String   @id @default(cuid())
  key        String   @unique
  track      Track
  moduleKey  String?
  prompt     String
  estMinutes Int
  xpReward   Int      @default(30)
  /// Position (1..96) of the lesson this drill came from, so a student on
  /// lesson 3 is never handed a lesson-90 exercise. Null on the older
  /// module-based pools, which stay eligible for everyone on their track.
  lessonOrder Int?
  createdAt  DateTime @default(now())

  logs DailyExerciseLog[]

  @@index([track])
}

model DailyExerciseLog {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    DailyExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  date        String
  completed   Boolean       @default(false)
  completedAt DateTime?
  fileUrl     String?
  fileName    String?

  @@unique([userId, date])
  @@index([exerciseId])
}
