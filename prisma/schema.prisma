generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Track {
  FRONTEND
  ROBOTICS
  OFFICE
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

enum EventType {
  CLASS
  DEADLINE
  EXAM
  EVENT
}

enum BuildingType {
  RESIDENTIAL
  TECH
  INDUSTRIAL
  MONUMENT
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementCategory {
  PROGRAMMING
  SPEED
  SOCIAL
  SPECIAL
  SECRET
}

enum AchievementCondition {
  FIRST_SUBMISSION
  SUBMISSIONS_COUNT
  MIDNIGHT_SUBMISSIONS
  PROBLEM_SUBMISSIONS_PASSED
  DIRECT_MESSAGES_SENT
  XP_REACHED
  LEVEL_REACHED
  STREAK_REACHED
  ELO_REACHED
  COINS_BALANCE
  BATTLES_WON
  SHOP_ITEMS_OWNED
  FRIENDS_COUNT
  TEAM_JOINED
  QUESTS_COMPLETED
  HOMEWORK_COMPLETED
  GRADES_ABOVE_90
}

enum ItemType {
  FRAME
  THEME
  BOOST
  MATERIAL
  UPGRADE
  TITLE
  BLUEPRINT
}

enum TeamRole {
  LEADER
  MEMBER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
  MASTER
}

enum BattleStatus {
  AWAITING_OPPONENT
  JUDGING
  JUDGED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum UiTheme {
  DARK
  NEON
  CYBER
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  role           Role     @default(STUDENT)
  track          Track?
  level          Int      @default(1)
  xp             Int      @default(0)
  coins          Int      @default(0)
  streak         Int      @default(0)
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  theme          UiTheme  @default(DARK)
  audioEnabled   Boolean  @default(true)
  onlineVisible  Boolean  @default(true)
  profilePublic  Boolean  @default(true)
  lastSeenAt     DateTime?
  eloRating      Int      @default(1200)

  teamId   String?
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamRole TeamRole?

  taughtClasses  ClassGroup[]     @relation("ClassTeacher")
  enrollments    Enrollment[]
  submissions    Submission[]
  grades         Grade[]
  homework       Homework[]
  attendances    Attendance[]
  notifications  Notification[]
  userQuests     UserQuest[]
  moduleProgress ModuleProgress[]
  buildings      Building[]

  userAchievements     UserAchievement[]
  inventory            UserInventory[]
  problemSubmissions   ProblemSubmission[]
  battlesAsChallenger  BattleChallenge[] @relation("BattleChallenger")
  battlesAsOpponent    BattleChallenge[] @relation("BattleOpponent")
  chatMessages         ChatMessage[]
  friendshipsSent      Friendship[]      @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]      @relation("FriendshipAddressee")
  sentMessages         DirectMessage[]   @relation("DMSender")
  receivedMessages     DirectMessage[]   @relation("DMRecipient")
  dailyExerciseLogs    DailyExerciseLog[]

  @@index([teamId])
}

model ClassGroup {
  id          String   @id @default(cuid())
  title       String
  track       Track
  teacherId   String
  teacher     User     @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  schedule    String?
  createdAt   DateTime @default(now())

  enrollments Enrollment[]
  assignments Assignment[]
  events      CalendarEvent[]
  attendances Attendance[]

  @@index([teacherId])
}

model Enrollment {
  id       String   @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId  String
  class    ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@unique([userId, classId])
  @@index([classId])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  track       Track
  classId     String?
  class       ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  dueDate     DateTime
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  submissions Submission[]
  grades      Grade[]

  @@index([classId])
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?
  githubUrl    String?
  demoUrl      String?
  fileUrl      String?
  fileName     String?
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?

  @@unique([assignmentId, userId])
  @@index([userId])
}

model Grade {
  id           String   @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  subject      String
  score        Float
  maxScore     Float    @default(100)
  gradedAt     DateTime @default(now())

  @@index([userId])
  @@index([assignmentId])
}

model Homework {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track
  title     String
  course    String
  dueDate   DateTime
  completed Boolean  @default(false)

  @@index([userId])
}

model Attendance {
  id      String   @id @default(cuid())
  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId String?
  class   ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  date    DateTime
  status  AttendanceStatus

  @@unique([userId, classId, date])
  @@index([classId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model CalendarEvent {
  id       String     @id @default(cuid())
  title    String
  track    Track?
  classId  String?
  class    ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  type     EventType
  startsAt DateTime
  endsAt   DateTime?

  @@index([classId])
}

model Quest {
  id         String   @id @default(cuid())
  track      Track?
  title      String
  xpReward   Int
  chapterId  String?

  userQuests UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, questId])
  @@index([questId])
}

model ModuleProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track
  moduleKey String
  progress  Int      @default(0)
  unlocked  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey])
}

model Building {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           BuildingType
  position       Json
  color          String
  secondaryColor String?
  name           String
  level          Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
}

model Achievement {
  id             String               @id @default(cuid())
  key            String               @unique
  name           String
  description    String
  rarity         Rarity
  category       AchievementCategory
  conditionType  AchievementCondition
  conditionValue Int

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlocked      Boolean   @default(false)
  progress      Int       @default(0)
  unlockedAt    DateTime?

  @@unique([userId, achievementId])
  @@index([achievementId])
}

model Item {
  id     String   @id @default(cuid())
  key    String   @unique
  name   String
  type   ItemType
  price  Int
  rarity Rarity

  inventories UserInventory[]
}

model UserInventory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acquiredAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([itemId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  motto     String?
  tag       String   @unique
  color     String
  createdAt DateTime @default(now())

  members User[]
}

model Problem {
  id             String     @id @default(cuid())
  key            String     @unique
  title          String
  difficulty     Difficulty
  points         Int
  tags           String[]
  description    String
  starterCodeJs  String
  starterCodePy  String
  starterCodeCpp String

  submissions ProblemSubmission[]
  battles     BattleChallenge[]
}

model ProblemSubmission {
  id            String   @id @default(cuid())
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String
  language      String
  passed        Boolean
  feedback      String
  pointsAwarded Int
  submittedAt   DateTime @default(now())

  @@index([userId])
  @@index([problemId])
}

model BattleChallenge {
  id              String       @id @default(cuid())
  challengerId    String
  challenger      User         @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String?
  opponent        User?        @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  isAI            Boolean      @default(false)
  problemId       String
  problem         Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        String       @default("javascript")
  status          BattleStatus @default(AWAITING_OPPONENT)
  challengerCode  String?
  opponentCode    String?
  challengerScore Int?
  opponentScore   Int?
  winnerId        String?
  feedback        String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([challengerId])
  @@index([opponentId])
  @@index([problemId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("DMRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model DailyExercise {
  id         String   @id @default(cuid())
  key        String   @unique
  track      Track
  moduleKey  String?
  prompt     String
  estMinutes Int
  xpReward   Int      @default(30)
  createdAt  DateTime @default(now())

  logs DailyExerciseLog[]

  @@index([track])
}

model DailyExerciseLog {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    DailyExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  date        String
  completed   Boolean       @default(false)
  completedAt DateTime?
  fileUrl     String?
  fileName    String?

  @@unique([userId, date])
  @@index([exerciseId])
}
