GEMINI_API_KEY=

# Also read directly by docker-compose.yml (${POSTGRES_PASSWORD}) to set the
# Postgres container's password and build DATABASE_URL for the app container —
# keep this and DATABASE_URL's password in sync when running via Docker.
POSTGRES_PASSWORD=techquest
DATABASE_URL=postgresql://techquest:techquest@localhost:5435/techquest
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
NODE_ENV=development

# Code execution sandbox for the "Run" button in Masalalar/CodeLab (Piston
# API, http://localhost:2000 in local dev via docker-compose's piston service).
PISTON_URL=http://localhost:2000
